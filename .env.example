# FreshRSS API Configuration (required)
FRESHRSS_API_URL=https://your-freshrss-instance/api/greader.php
FRESHRSS_USERNAME=your_username
FRESHRSS_API_PASSWORD=your_api_password

# Optional: Public URL of the FreshRSS web UI, used to build links to articles.
# Defaults to FRESHRSS_API_URL with "/api/greader.php" stripped off. Set this
# when the two differ -- e.g. under Docker Compose, where the API is reached
# over an internal hostname that your browser cannot resolve.
# FRESHRSS_BASE_URL=https://your-freshrss-instance

# Optional: Request timeout in seconds (default: 30)
# REQUEST_TIMEOUT=30

# Optional: Default article limit (default: 100)
# DEFAULT_ARTICLE_LIMIT=100

# MCP Server Configuration
# Transport mode: "stdio", "sse", or "streamable-http" (default: sse)
# MCP_TRANSPORT=sse

# HTTP server host (default: :: for all interfaces)
# MCP_HOST=::

# HTTP server port (default: 8080, Railway auto-injects PORT)
# MCP_PORT=8080

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# API Authentication (recommended for remote deployments)
# If set, clients must include "Authorization: Bearer <API_KEY>" header
# API_KEY=your-secret-key
